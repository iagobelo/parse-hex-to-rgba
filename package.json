{
  "name": "parse-hex-to-rgba",
  "version": "1.0.0",
  "description": "Converts a HEX color to a RGBA color. Supports 3, 4, 6 and 8 digit notation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && npm run build:types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "build:types": "tsc -p tsconfig.build.json && node scripts/duplicate-cjs-types.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iagobelo/parse-hex-to-rgba.git"
  },
  "keywords": [
    "hex",
    "rgba",
    "rgb",
    "color",
    "css",
    "convert",
    "parse",
    "hex-to-rgba",
    "alpha",
    "typescript"
  ],
  "author": {
    "name": "Iago Belo"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iagobelo/parse-hex-to-rgba/issues"
  },
  "homepage": "https://github.com/iagobelo/parse-hex-to-rgba#readme"
}
